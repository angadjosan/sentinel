# Sentinel environment configuration
# Copy this file to .env and fill in the required values.
# docker compose --env-file .env -f docker-compose.prod.yml up -d

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-strong-password   # REQUIRED — use a strong random string
POSTGRES_DB=sentinel

# ── API security ──────────────────────────────────────────────────────────────
SENTINEL_JWT_SECRET=change-me-random-secret   # REQUIRED — generate with: openssl rand -hex 32

# ── Ports (optional — defaults shown) ────────────────────────────────────────
API_PORT=8000
DASHBOARD_PORT=3000

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# CORS_ORIGINS=https://your-domain.com,https://dashboard.your-domain.com

# ── Public API URL (dashboard → browser → API) ───────────────────────────────
# The URL the browser uses to reach the API. Must be publicly accessible.
# PUBLIC_API_URL=https://api.your-domain.com

# ── Public dashboard URL ──────────────────────────────────────────────────────
# Used to build the `sentinel auth login` device-approval link, and email
# verification / password reset links. Without this, device codes fall back to
# a plaintext instructions page on the API, and email links are relative paths.
# PUBLIC_DASHBOARD_URL=https://dashboard.your-domain.com

# ── GitHub OAuth sign-in (optional) ───────────────────────────────────────────
# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL {PUBLIC_DASHBOARD_URL}/auth/github/callback. Without these, the
# "Sign in with GitHub" button on /login and /signup fails gracefully (501).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ── Transactional email (optional) ────────────────────────────────────────────
# Used for email verification and password reset links. Without RESEND_API_KEY,
# these emails are logged instead of sent — fine for self-hosting, not for a
# real deployment with users who might lose access to their account.
# RESEND_API_KEY=
# EMAIL_FROM=Sentinel <onboarding@resend.dev>

# ── Docker images (optional — defaults to GHCR images) ───────────────────────
# Override to use locally-built or registry-hosted images.
# SENTINEL_IMAGE_API=ghcr.io/your-org/sentinel/api:v0.1.0
# SENTINEL_IMAGE_DASHBOARD=ghcr.io/your-org/sentinel/dashboard:v0.1.0

# ── Worker tuning (optional) ──────────────────────────────────────────────────
# WORKER_POLL_INTERVAL=2    # seconds between queue polls
